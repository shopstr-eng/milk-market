{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "MOBILE_APP_VARIANT": "development"
      },
      "node": "22.23.2"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "MOBILE_APP_VARIANT": "staging"
      },
      "android": {
        "buildType": "apk"
      },
      "node": "22.23.2"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "MOBILE_APP_VARIANT": "production"
      },
      "node": "22.23.2"
    }
  }
}
